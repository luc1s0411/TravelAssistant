APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
# Local development placeholders only. Keep these consistent with compose.yaml.
MYSQL_DATABASE=travel_assistant
MYSQL_USER=travel
MYSQL_PASSWORD=local-dev-change-me
MYSQL_ROOT_PASSWORD=local-root-change-me
MYSQL_PORT=3306
DATABASE_URL=mysql+pymysql://travel:local-dev-change-me@127.0.0.1:3306/travel_assistant?charset=utf8mb4
SESSION_SECRET=development-only-change-before-production
AUTH_MODE=password
CATALOG_PROVIDER_MODE=demo
MODEL_PROVIDER=demo
AMAP_WEB_SERVICE_KEY=
QWEATHER_API_HOST=
QWEATHER_AUTH_MODE=jwt
QWEATHER_PRIVATE_KEY_PATH=
MODEL_BASE_URL=
MODEL_NAME=
MODEL_API_KEY=
UPSTREAM_TIMEOUT_SECONDS=15
PLAN_TIMEOUT_SECONDS=120
PLAN_CONCURRENCY_LIMIT=3
MODEL_MAX_RETRIES=1
